# Estado e cache do Terraform/OpenTofu (contêm segredos)
**/.terraform/
*.tfstate
*.tfstate.*
terraform/estado/
*.tfplan
tfplan
crash.log
terraform/terraform.tfvars
*.auto.tfvars
# Ansible
ansible/.tls/
ansible/collections/
ansible/group_vars/all/vault.yml
ansible/.vault_pass*
*.retry
# Logs e temporários das medições
medicao/logs/
medicao/.tmp/
__pycache__/
# Dataset público (INEP): não versionar o zip nem o CSV bruto; reproduzir com dados/gerar_cenarios.py
dados/*.zip
dados/microdados_*/
dados/**/*.csv
