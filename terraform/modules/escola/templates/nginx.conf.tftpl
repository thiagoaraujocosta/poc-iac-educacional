# Gerado pelo Terraform (módulo escola). Não edite dentro do contêiner.
server {
    listen 443 ssl;
    http2 on;
    server_name ${dominio};

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1h;

    # Trechos adicionais (cabeçalhos de segurança aplicados pelo Ansible).
    include /etc/nginx/snippets/*.conf;

    # DNS interno do Docker: resolve os nomes dos contêineres em tempo de requisição.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
%{ if habilitar_moodle }
    location / {
        set $moodle_upstream http://${prefixo}-moodle:8080;
        proxy_pass $moodle_upstream;
        proxy_http_version 1.1;
        # Host não é repassado: com MOODLE_REVERSEPROXY=yes o Moodle devolve erro 500 ("Reverse proxy enabled so the
        # server cannot be accessed directly") quando o Host da requisição é igual ao host do wwwroot. O padrão do
        # nginx ($proxy_host, o nome do contêiner) funciona, e os links usam o wwwroot configurado em MOODLE_HOST.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        client_max_body_size 100m;
    }
%{ else }
    location / {
        default_type text/plain;
        return 200 "Escola sem carga de trabalho Moodle.\n";
    }
%{ endif }
}
